                "offset": 104
              }
            ]
          }
        }
      ],
      "sections": [
        {
          "id": "light-and-life",
          "type": "section",
          "title": "Light and Life",
          "content": [
            {
              "type": "paragraph",
              "content": {
                "text": "John tells the story in the same order. In John 1:4 the Word is the source of life, and that life is the light of men: the light of Genesis turns out to have a name.",
                "annotations": [
                  {
                    "type": "scripture",
                    "start": 43,
                    "end": 51,
                    "text": "John 1:4",
                    "data": {
                      "sv": 43001004
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
